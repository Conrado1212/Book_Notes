<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
    <script src="/app.js" defer></script>
    <title>Add book</title>
</head>
<body>
    <div class="form_wrapper">
        <div class="lib_head">
            <svg class="book_icon"
     viewBox="0 0 24 24"
     width="40"
     height="40"
     fill="var(--book-page)"
     stroke="currentColor"
     stroke-width="1.5"
     stroke-linecap="round"
     stroke-linejoin="round">

    <!-- lewa strona -->
    <path d="M4 5
             C4 3.5 5.5 2.5 7 2.5
             C9 2.5 10.5 3.2 12 4
             V21
             C10.5 20 9 19.5 7 19.5
             C5.5 19.5 4 20.5 4 22
             V5Z" />
             <g stroke="var(--accent)" opacity="0.4">
                <path d="M6.5 7h3" />
                <path d="M6.5 9h3.5" />
                <path d="M6.5 11h3" />
            
                <path d="M17.5 7h-3" />
                <path d="M17.5 9h-3.5" />
                <path d="M17.5 11h-3" />
            </g>
    <!-- prawa strona -->
    <path d="M20 5
             C20 3.5 18.5 2.5 17 2.5
             C15 2.5 13.5 3.2 12 4
             V21
             C13.5 20 15 19.5 17 19.5
             C18.5 19.5 20 20.5 20 22
             V5Z" />
             <g stroke="var(--accent)" opacity="0.4">
                <path d="M6.5 7h3" />
                <path d="M6.5 9h3.5" />
                <path d="M6.5 11h3" />
            
                <path d="M17.5 7h-3" />
                <path d="M17.5 9h-3.5" />
                <path d="M17.5 11h-3" />
            </g>
    <!-- linia grzbietu -->
    <path d="M12 4V21" />

</svg> <h2 class="title">Add Book</h2>
        </div>
        <div class="form_shadow">
      
            <form action="/add" method="post" class="add_form" id="addForm">
                <label for="title">
                    Title
                </label>
                <input type="text" name="title" id="title" placeholder="Enter book title" required>
                <label for="author">
                    Author
                </label>
                <input type="text" name="author" id="author" placeholder="Enter author" required>
                <div class="rating">
                    <input type="radio" name="rating" id="star5" value="5" >
                    <label for="star5">★</label>
                
                    <input type="radio" name="rating" id="star4" value="4">
                    <label for="star4">★</label>
                
                    <input type="radio" name="rating" id="star3" value="3">
                    <label for="star3">★</label>
                
                    <input type="radio" name="rating" id="star2" value="2">
                    <label for="star2">★</label>
                
                    <input type="radio" name="rating" id="star1" value="1" >
                    <label for="star1">★</label>
                </div>
                <label for="date">
                    Date read
                </label>
                <input type="date" name="date_read" id="date_read" required>
                <label for="review">
                    Review
                </label>
                <textarea name="review" id="review" placeholder="Enter review about book" rows="10" required></textarea>
                <div class="btn_wrapper">
                    <button class="add btn" type="submit" id="addBtn">Add book</button>
                </div>
            </form>
      
        </div>
        
    </div>
</body>
</html>